# ========== 基础配置 ==========
LOG_LEVEL=info
# 配置文件目录（留空则依次查找 ./config、仓库根 config、安装目录 share/tickhub-us/config）
TICKHUB_US_CONFIG_DIR=
# Redis（不可用时自动降级为进程内缓存，不阻塞请求）
REDIS_URL=redis://127.0.0.1:6379/0
# prod | dev | off（off 关闭缓存，dev 缩短 TTL）
CACHE_ENV=prod

# ========== MCP / 进程 ==========
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001
MCP_HTTP_PATH=/mcp
# 鉴权令牌：只在绑定非回环地址（如 0.0.0.0）时必填，否则启动即报错。
# 设置后除 /healthz 外所有 HTTP 请求都必须带 Authorization: Bearer <token>。
MCP_HTTP_TOKEN=
# 绑定 0.0.0.0 / :: 时必须声明客户端实际使用的 Host 头（逗号分隔），否则启动即报错。
# 例：MCP_HTTP_ALLOWED_HOSTS=tickhub.internal:8001
MCP_HTTP_ALLOWED_HOSTS=
# 允许的浏览器 Origin（逗号分隔）；仅当有浏览器客户端跨源调用时才需要。
MCP_HTTP_ALLOWED_ORIGINS=

# ========== HTTP ==========
HTTP_TIMEOUT=20
HTTP_RETRIES=2

# ========== 数据源 ==========
# SEC 要求声明真实联系方式的 User-Agent，未设置时 SEC 层会拒绝请求
SEC_CONTACT=
# 可选：Polygon.io 主数据源（留空则跳过，直接走 Yahoo）
POLYGON_API_KEY=
# Polygon 商用作答：密钥只证明存在订阅，不证明订阅含商用权利。
# 确认订阅协议允许商用后再设为 true，否则商用调用仍按 Tier C 拒绝。
TICKHUB_US_POLYGON_COMMERCIAL_BASIS=false
# Yahoo（D 级：条款禁止自动抓取，仅供个人研究；商用请求会被合规拦截）
YAHOO_ENABLE=true
# B 级数据源（FINRA / EIA 现货价）商用放行：
# 推荐按源白名单，逐项核实条款后只放行确认过的源（逗号分隔）。
TICKHUB_US_ALLOW_TIER_B_SOURCES=
# 粗粒度开关：放行全部 Tier B 源。白名单非空时以白名单为准，未列出的源仍被拒绝。
TICKHUB_US_ALLOW_TIER_B_COMMERCIAL=false
